{
  "name": "booth-stamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b && vitest run",
    "check:functions": "deno check supabase/functions/claim-stamp/index.ts supabase/functions/admin-action/index.ts",
    "test:functions": "deno test --allow-env=ALLOWED_ORIGINS,SUPABASE_URL,SUPABASE_SERVICE_ROLE_KEY tests/functions",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy claim-stamp && supabase functions deploy admin-action"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "deno": "^2.9.6",
    "prettier": "^3.9.9",
    "supabase": "^2.75.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
